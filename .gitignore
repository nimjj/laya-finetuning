# model weights and local checkpoint copies (they live on Google Drive and on your PC, never in git)
checkpoints/
*.safetensors
*.pt
*.bin

# notebooks and python noise
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.venv/

# secrets
.env
.env.*

# a duplicate unzip of a checkpoint run at the repo root (the real copy lives in checkpoints/)
/smoke-*/

# run logs next to probe results (the .json beside each log is the record)
inputs/Test (results)/**/*.log

# editor and tool state
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
